#!/bin/sh
# Keeps the 1Password Connect server of a CI runner host running: the two
# containers (the API on loopback and the Docker bridge's gateway, the sync
# beside it) over one data volume, from the credentials file the role wrote
# (§ 8 PLX-Delivery). A container already on the right image and
# credentials is left running. Managed by Ansible (actions_runners), run by
# the role and the hourly housekeeping. Hand-runnable as root:
# ci-connect-refresh; with RECREATE=True both containers are created anew
# (new credentials).
#
# From /etc/op-connect/connect.env: IMAGE_API, IMAGE_SYNC, PORT and
# CREDENTIALS, the file's path; the containers read the file itself.
set -eu
# shellcheck source=/dev/null
. /etc/op-connect/connect.env
stamp=$(sha256sum "$CREDENTIALS" | cut -c1-16)
# The host's address on the default bridge, for the large slot's own network.
gateway=$(docker network inspect bridge --format '{{ (index .IPAM.Config 0).Gateway }}')

ensure() {
  name=$1 image=$2
  shift 2
  have=$(docker inspect --format '{{ index .Config.Labels "plexus.ci.credentials" }} {{ .Config.Image }} {{ .State.Running }}' "$name" 2>/dev/null || true)
  [ "${RECREATE:-}" != True ] && [ "$have" = "$stamp $image true" ] && return 0
  docker rm --force "$name" >/dev/null 2>&1 || true
  docker run --detach --name "$name" --restart unless-stopped \
    --label "plexus.ci.credentials=$stamp" \
    --volume "$CREDENTIALS:/home/opuser/.op/1password-credentials.json:ro" \
    --volume op-connect-data:/home/opuser/.op/data \
    "$@" "$image" >/dev/null
  echo "$name: created ($image)"
}
ensure op-connect-api "$IMAGE_API" \
  --publish "127.0.0.1:$PORT:8080" --publish "$gateway:$PORT:8080"
ensure op-connect-sync "$IMAGE_SYNC"
