# Managed by Ansible (plexus.platform.ingress). The routes live in apps.caddy,
# rendered from this host's app records; the options below are host-level
# (what sits in front of this VM).
{% set trusted = ingress_cloudflare_ranges if ingress_trusted_proxies == 'cloudflare' else ingress_trusted_proxies %}
{% if ingress_proxy_protocol_from or trusted %}
{
	servers {
{% if ingress_proxy_protocol_from %}
		# The ingress in front sends the PROXY protocol, so Caddy sees the real
		# TCP peer instead of the ingress; read before TLS.
		listener_wrappers {
			proxy_protocol {
				allow {{ ingress_proxy_protocol_from | join(' ') }}
			}
			tls
		}
{% endif %}
{% if trusted %}
		# Client address from the proxy's header, believed only when the peer is
		# one of these; a request that bypasses the proxy cannot forge it.
		trusted_proxies static {{ trusted | join(' ') }}
		client_ip_headers {{ ingress_client_ip_header }}
{% endif %}
	}
}
{% endif %}
import apps.caddy
